# Variables privadas para las funciones de Vercel. Nunca uses el prefijo PUBLIC_.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR

# Clave publica de Supabase. Se usa en el servidor para iniciar la sesion del admin.
# Puede comenzar con sb_publishable_ o ser la clave anon legacy.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR

# Solo para proyectos antiguos de Supabase que todavía no muestran Secret keys.
# SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR
# SUPABASE_ANON_KEY=REEMPLAZAR
