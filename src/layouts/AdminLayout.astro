---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#30362f" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="admin-body">
    <slot />
  </body>
</html>

<style is:global>
  .admin-body {
    min-height: 100vh;
    background:
      radial-gradient(circle at 10% 0%, rgba(183, 155, 100, .16), transparent 32rem),
      linear-gradient(145deg, #f8f5ee, #ebe6dc);
  }
</style>
