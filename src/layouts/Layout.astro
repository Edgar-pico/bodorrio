---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Edgar & Brenda | Boda" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Invitación de boda de Edgar y Brenda - 23 de Mayo, 2026" />
    <link rel="icon" href="/favicon.ico" />
    
    <!-- Preload de imágenes críticas -->
    <link rel="preload" as="image" href="/inicio-1.jpg" />
    <link rel="preload" as="image" href="/inicio-2.jpg" />
    
    <!-- DNS Prefetch para Google Maps -->
    <link rel="dns-prefetch" href="https://maps.app.goo.gl" />
    
    <title>{title}</title>
  </head>
  <body class="bg-stone-50 text-stone-900 antialiased">
    <slot />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  
  /* Optimización de imágenes de fondo */
  .bg-fixed {
    will-change: transform;
  }
  
  /* Reducir motion para usuarios que lo prefieran */
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>