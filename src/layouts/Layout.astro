---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Edgar & Brenda | Boda" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Nuestra historia continúa. Acompaña a Edgar y Brenda en el siguiente capítulo: nuestro sí ante Dios." />
    <meta name="theme-color" content="#30362f" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Capítulo II — Nuestro sí ante Dios." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/inicio-2.webp" />
    <link rel="icon" href="/favicon.ico" />
    
    <!-- Preload de imágenes críticas -->
    <link rel="preload" as="image" href="/inicio-1.webp" fetchpriority="high" />
    
    <title>{title}</title>
  </head>
  <body class="bg-stone-50 text-stone-900 antialiased">
    <slot />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  
  /* Reducir motion para usuarios que lo prefieran */
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
