---
import Layout from '../layouts/Layout.astro';
import Splash from '../components/Splash.svelte';
import ProgressPath from '../components/ProgressPath.svelte';
import Hero from '../components/Hero.svelte';
import CeremoniaCivil from '../components/CeremoniaCivil.svelte';
import Comida from '../components/Comida.svelte';
import Ninos from '../components/Ninos.svelte';
import Iglesia from '../components/Iglesia.svelte';
import Countdown from '../components/Countdown.svelte';
import ChaptersIntro from '../components/ChaptersIntro.astro';
import ChapterTransition from '../components/ChapterTransition.astro';
import NuestraHistoria from '../components/NuestraHistoria.astro';
import GuestDetails from '../components/GuestDetails.astro';
import Gifts from '../components/Gifts.astro';
import Rsvp from '../components/Rsvp.svelte';
import Closing from '../components/Closing.astro';
import { weddingConfig } from '../lib/wedding-config';
---

<Layout title="Edgar & Brenda | Nuestra historia continúa">
  <Splash client:load />
  <ProgressPath client:idle />
  <main>
    <Hero />
    <ChaptersIntro />
    <CeremoniaCivil />
    <ChapterTransition />
    <Iglesia />
    <Countdown eventDate={weddingConfig.religious.dateIso} dateLabel={weddingConfig.religious.dateLabel} client:visible />
    <Comida />
    <NuestraHistoria {...weddingConfig.storyVideo} />
    <GuestDetails />
    <Ninos />
    <Gifts amazon={weddingConfig.gifts.amazon} liverpool={weddingConfig.gifts.liverpool} />
    <Rsvp confirmationWhatsApp={weddingConfig.religious.confirmationWhatsApp} client:visible />
    <Closing />
  </main>
</Layout>
