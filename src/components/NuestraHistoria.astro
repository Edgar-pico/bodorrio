---
interface Props {
  url?: string | null;
  poster?: string | null;
  title?: string;
  description?: string;
  autoplay?: boolean;
  controls?: boolean;
}

const {
  title = 'Nuestra historia',
  description = 'De dos ciudades diferentes, dos historias comenzaron a acercarse sin saberlo.'
} = Astro.props;

const storyPages = [
  { page: 1, chapter: 'Portada', title: 'Como si nos conociéramos de toda la vida' },
  { page: 2, chapter: 'Capítulo 1', title: 'Dos ciudades, un mismo camino' },
  { page: 3, chapter: 'Capítulo 2', title: 'Una solicitud inesperada' },
  { page: 4, chapter: 'Capítulo 3', title: 'La conversación de la banca' },
  { page: 5, chapter: 'Capítulo 4', title: 'Un abrazo antes de volver a clases' },
  { page: 6, chapter: 'Capítulo 5', title: 'La llamada de Siddhartha' },
  { page: 7, chapter: 'Capítulo 6', title: 'El viaje y la primera cita' },
  { page: 8, chapter: 'Capítulo 7', title: 'El beso que tuvo que esperar' },
  { page: 9, chapter: 'Capítulo 8', title: '¿A dónde vas?' },
  { page: 10, chapter: 'Capítulo 9', title: 'El comienzo de nosotros' },
  { page: 11, chapter: 'Capítulo 10', title: 'Días, meses y años' },
  { page: 12, chapter: 'Capítulo 11', title: 'Elegir continuar juntos' },
  { page: 13, chapter: 'Capítulo 12', title: 'La pregunta más importante' },
  { page: 14, chapter: 'Capítulo 13', title: 'Nuestro primer sí' },
  { page: 15, chapter: 'Capítulo 14', title: 'Nuestra historia continúa' }
];
---

<section id="historia" class="story-comic reveal-section" aria-labelledby="story-title" data-story-root>
  <div class="story-glow story-glow--one" aria-hidden="true"></div>
  <div class="story-glow story-glow--two" aria-hidden="true"></div>

  <header class="story-header">
    <p class="eyebrow">¿Cómo llegamos hasta aquí?</p>
    <h2 id="story-title">{title}</h2>
    <p class="story-lead">{description}</p>
    <p class="story-copy">Y aunque hoy conoces el final… quizá no conoces todo lo que pasó antes.</p>
    <div class="story-ornament" aria-hidden="true"><i></i><span>✦</span><i></i></div>
  </header>

  <div class="story-cinema" aria-label="Historieta de Brenda y Edgar">
    <div class="film-topbar">
      <span>Nuestra historia · Brenda &amp; Edgar</span>
      <span data-story-counter aria-live="polite">01 / {String(storyPages.length).padStart(2, '0')}</span>
    </div>

    <div class="film-progress" aria-hidden="true">
      <span data-story-progress></span>
    </div>

    <div class="story-current-meta" aria-live="polite">
      <span data-story-chapter>{storyPages[0].chapter}</span>
      <strong data-story-title>{storyPages[0].title}</strong>
    </div>

    <div
      class="story-stage"
      data-story-stage
      tabindex="0"
      role="group"
      aria-label="Páginas de nuestra historia. Usa las flechas izquierda y derecha para cambiar de capítulo."
    >
      {storyPages.map((item, index) => {
        const number = String(item.page).padStart(2, '0');
        const jpg = `/nuestra-historia/pagina-${number}.jpg`;
        const webp = `/nuestra-historia/pagina-${number}.webp`;

        return (
          <article
            class:list={['story-slide', { 'is-active': index === 0 }]}
            aria-hidden={index === 0 ? 'false' : 'true'}
            data-story-slide
            data-full={jpg}
            data-chapter={item.chapter}
            data-title={item.title}
          >
            <a
              class="story-page-link"
              href={jpg}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Abrir ${item.title} en tamaño completo`}
              tabindex={index === 0 ? 0 : -1}
              data-story-page-link
            >
              <picture>
                <source srcset={webp} type="image/webp" />
                <img
                  src={jpg}
                  alt={`${item.chapter}: ${item.title}`}
                  width="1600"
                  height="2000"
                  loading={index < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </picture>
            </a>
          </article>
        );
      })}
    </div>

    <div class="story-controls">
      <button class="story-nav" type="button" data-story-prev disabled aria-label="Página anterior">
        <span aria-hidden="true">←</span>
        <span>Anterior</span>
      </button>

      <a
        class="story-open"
        href="/nuestra-historia/pagina-01.jpg"
        target="_blank"
        rel="noopener noreferrer"
        data-story-open
      >
        Ver página completa <span aria-hidden="true">↗</span>
      </a>

      <button class="story-nav" type="button" data-story-next aria-label="Siguiente página">
        <span>Siguiente</span>
        <span aria-hidden="true">→</span>
      </button>
    </div>

    <div class="story-dots" aria-label="Ir a un capítulo" data-story-dots>
      {storyPages.map((item, index) => (
        <button
          type="button"
          class:list={['story-dot', { 'is-active': index === 0 }]}
          aria-label={`Ir a ${item.chapter}: ${item.title}`}
          aria-current={index === 0 ? 'page' : undefined}
          data-story-dot
          data-index={index}
        >
          {String(index + 1).padStart(2, '0')}
        </button>
      ))}
    </div>

    <p class="story-hint">Desliza o usa las flechas para pasar cada hoja. También puedes abrir la página completa.</p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-story-root]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-story-slide]'));
    const pageLinks = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-story-page-link]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-story-dot]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-story-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-story-next]');
    const counter = root.querySelector<HTMLElement>('[data-story-counter]');
    const progress = root.querySelector<HTMLElement>('[data-story-progress]');
    const openLink = root.querySelector<HTMLAnchorElement>('[data-story-open]');
    const stage = root.querySelector<HTMLElement>('[data-story-stage]');
    const dotsScroller = root.querySelector<HTMLElement>('[data-story-dots]');
    const currentChapter = root.querySelector<HTMLElement>('[data-story-chapter]');
    const currentTitle = root.querySelector<HTMLElement>('[data-story-title]');

    if (
      !slides.length ||
      !prev ||
      !next ||
      !counter ||
      !progress ||
      !openLink ||
      !stage ||
      !dotsScroller ||
      !currentChapter ||
      !currentTitle
    ) return;

    let activeIndex = 0;
    let startX = 0;
    let startY = 0;
    let isAnimating = false;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const centerActiveDot = (behavior: ScrollBehavior = 'smooth') => {
      const activeDot = dots[activeIndex];
      if (!activeDot) return;

      const desiredLeft =
        activeDot.offsetLeft - (dotsScroller.clientWidth - activeDot.offsetWidth) / 2;
      const maxLeft = Math.max(0, dotsScroller.scrollWidth - dotsScroller.clientWidth);
      const left = Math.max(0, Math.min(desiredLeft, maxLeft));

      // Importante: desplazamos SOLO la tira de capítulos.
      // No usamos scrollIntoView(), porque puede desplazar también el viewport.
      dotsScroller.scrollTo({ left, top: 0, behavior });
    };

    const renderChrome = (centerDot = false) => {
      dots.forEach((dot, index) => {
        const active = index === activeIndex;
        dot.classList.toggle('is-active', active);
        if (active) dot.setAttribute('aria-current', 'page');
        else dot.removeAttribute('aria-current');
      });

      pageLinks.forEach((link, index) => {
        link.tabIndex = index === activeIndex ? 0 : -1;
      });

      prev.disabled = activeIndex === 0;
      next.disabled = activeIndex === slides.length - 1;
      counter.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
      progress.style.width = `${((activeIndex + 1) / slides.length) * 100}%`;

      const activeSlide = slides[activeIndex];
      const full = activeSlide?.dataset.full;
      if (full) openLink.href = full;

      currentChapter.textContent = activeSlide?.dataset.chapter ?? '';
      currentTitle.textContent = activeSlide?.dataset.title ?? '';

      if (centerDot) centerActiveDot();
    };

    const showImmediately = (targetIndex: number, centerDot = false) => {
      activeIndex = Math.max(0, Math.min(targetIndex, slides.length - 1));

      slides.forEach((slide, index) => {
        const active = index === activeIndex;
        slide.classList.toggle('is-active', active);
        slide.classList.remove(
          'is-turning-out-next',
          'is-turning-in-next',
          'is-turning-out-prev',
          'is-turning-in-prev'
        );
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });

      renderChrome(centerDot);
    };

    const goTo = (requestedIndex: number) => {
      const targetIndex = Math.max(0, Math.min(requestedIndex, slides.length - 1));
      if (targetIndex === activeIndex || isAnimating) return;

      const fromIndex = activeIndex;
      const currentSlide = slides[fromIndex];
      const targetSlide = slides[targetIndex];
      if (!currentSlide || !targetSlide) return;

      const direction = targetIndex > fromIndex ? 'next' : 'prev';
      activeIndex = targetIndex;

      if (reduceMotion) {
        currentSlide.classList.remove('is-active');
        currentSlide.setAttribute('aria-hidden', 'true');
        targetSlide.classList.add('is-active');
        targetSlide.setAttribute('aria-hidden', 'false');
        renderChrome(true);
        return;
      }

      isAnimating = true;

      const outClass = direction === 'next' ? 'is-turning-out-next' : 'is-turning-out-prev';
      const inClass = direction === 'next' ? 'is-turning-in-next' : 'is-turning-in-prev';

      currentSlide.classList.add('is-active', outClass);
      targetSlide.classList.add('is-active', inClass);
      currentSlide.setAttribute('aria-hidden', 'false');
      targetSlide.setAttribute('aria-hidden', 'false');

      renderChrome(true);

      let finished = false;
      const finish = () => {
        if (finished) return;
        finished = true;

        currentSlide.classList.remove('is-active', outClass);
        currentSlide.setAttribute('aria-hidden', 'true');
        targetSlide.classList.remove(inClass);
        targetSlide.classList.add('is-active');
        targetSlide.setAttribute('aria-hidden', 'false');
        isAnimating = false;
      };

      targetSlide.addEventListener('animationend', finish, { once: true });
      window.setTimeout(finish, 760);
    };

    prev.addEventListener('click', () => goTo(activeIndex - 1));
    next.addEventListener('click', () => goTo(activeIndex + 1));

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const index = Number(dot.dataset.index);
        if (Number.isFinite(index)) goTo(index);
      });
    });

    stage.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(activeIndex - 1);
      }

      if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(activeIndex + 1);
      }
    });

    stage.addEventListener('pointerdown', (event: PointerEvent) => {
      startX = event.clientX;
      startY = event.clientY;
    });

    stage.addEventListener('pointerup', (event: PointerEvent) => {
      const deltaX = event.clientX - startX;
      const deltaY = event.clientY - startY;

      // Si el gesto fue principalmente vertical, dejamos que la página haga scroll normal.
      if (Math.abs(deltaY) > Math.abs(deltaX)) return;
      if (Math.abs(deltaX) < 48) return;

      if (deltaX < 0) goTo(activeIndex + 1);
      else goTo(activeIndex - 1);
    });

    stage.addEventListener('pointercancel', () => {
      startX = 0;
      startY = 0;
    });

    showImmediately(0, false);
  });
</script>

<style>
  .story-comic {
    position: relative;
    width: 100%;
    max-width: 100vw;
    min-width: 0;
    overflow: hidden;
    overflow-x: clip;
    overscroll-behavior-x: contain;
    padding: clamp(5.5rem, 9vw, 8.5rem) clamp(0.8rem, 3vw, 2.5rem);
    border-block: 1px solid rgba(185, 151, 88, 0.25);
    background:
      radial-gradient(circle at 50% 0%, rgba(184, 150, 85, 0.08), transparent 34rem),
      #20251f;
    color: #f4f0e8;
    content-visibility: auto;
    contain-intrinsic-size: 1500px;
  }

  .story-comic::before {
    content: '';
    position: absolute;
    inset: 1rem;
    border: 1px solid rgba(184, 150, 85, 0.12);
    pointer-events: none;
  }

  .story-glow {
    position: absolute;
    width: 36rem;
    height: 36rem;
    border-radius: 50%;
    background: rgba(164, 124, 67, 0.08);
    filter: blur(100px);
    pointer-events: none;
  }

  .story-glow--one {
    top: -18rem;
    right: -16rem;
  }

  .story-glow--two {
    bottom: -20rem;
    left: -16rem;
  }

  .story-header {
    position: relative;
    z-index: 2;
    width: min(840px, 100%);
    min-width: 0;
    margin-inline: auto;
    text-align: center;
  }

  .story-header .eyebrow {
    margin: 0 0 1rem;
    color: #c9ad73;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.27em;
    text-transform: uppercase;
  }

  .story-header h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(3rem, 7vw, 5.6rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .story-lead {
    max-width: 690px;
    margin: 1.35rem auto 0;
    color: rgba(244, 240, 232, 0.78);
    font-family: var(--serif);
    font-size: clamp(1.05rem, 1.8vw, 1.28rem);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .story-copy {
    margin: 0.8rem auto 0;
    color: rgba(244, 240, 232, 0.58);
    font-family: var(--serif);
    font-size: 0.98rem;
  }

  .story-ornament {
    width: min(240px, 60vw);
    margin: 1.8rem auto 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    color: #c9ad73;
  }

  .story-ornament i {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, currentColor);
  }

  .story-ornament i:last-child {
    background: linear-gradient(90deg, currentColor, transparent);
  }

  .story-ornament span {
    font-size: 0.7rem;
  }

  .story-cinema {
    position: relative;
    z-index: 2;
    width: min(980px, 100%);
    max-width: 100%;
    min-width: 0;
    margin: clamp(2.5rem, 5vw, 4.5rem) auto 0;
    padding: clamp(0.8rem, 2vw, 1.35rem);
    overflow: hidden;
    border: 1px solid rgba(201, 173, 115, 0.35);
    background: #111510;
    box-shadow: 0 34px 95px rgba(0, 0, 0, 0.32);
  }

  .film-topbar {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.15rem 0.25rem 0.75rem;
    color: rgba(239, 231, 215, 0.68);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .film-topbar > span:first-child {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .film-topbar > span:last-child {
    flex: 0 0 auto;
  }

  .film-progress {
    height: 2px;
    overflow: hidden;
    background: rgba(201, 173, 115, 0.16);
  }

  .film-progress span {
    display: block;
    width: 0;
    height: 100%;
    background: #c9ad73;
    transition: width 360ms ease;
  }

  .story-stage {
    position: relative;
    width: min(760px, 100%);
    max-width: 100%;
    min-width: 0;
    aspect-ratio: 4 / 5;
    margin: 1rem auto;
    overflow: hidden;
    isolation: isolate;
    contain: layout paint;
    background: #2a1c18;
    touch-action: pan-y;
    perspective: 1600px;
    perspective-origin: 50% 50%;
    outline: none;
  }

  .story-stage:focus-visible {
    box-shadow: 0 0 0 2px rgba(201, 173, 115, 0.72);
  }

  .story-stage::before,
  .story-stage::after {
    content: '';
    position: absolute;
    z-index: 8;
    top: 0;
    bottom: 0;
    width: 16px;
    pointer-events: none;
    opacity: 0.42;
    background:
      radial-gradient(circle, #d7bd85 2px, transparent 2.5px) center top / 10px 18px repeat-y;
  }

  .story-stage::before { left: 2px; }
  .story-stage::after { right: 2px; }

  .story-slide {
    position: absolute;
    inset: 0;
    z-index: 1;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: rotateY(0deg) translateZ(0);
    transform-style: preserve-3d;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    will-change: transform, opacity;
  }

  .story-slide::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 7;
    pointer-events: none;
    opacity: 0;
  }

  .story-slide.is-active {
    z-index: 2;
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  /* Efecto de hoja: siguiente capítulo */
  .story-slide.is-turning-out-next {
    z-index: 5;
    visibility: visible;
    transform-origin: left center;
    pointer-events: none;
    animation: story-page-out-next 680ms cubic-bezier(0.42, 0, 0.18, 1) both;
  }

  .story-slide.is-turning-in-next {
    z-index: 4;
    visibility: visible;
    transform-origin: right center;
    pointer-events: none;
    animation: story-page-in-next 680ms cubic-bezier(0.42, 0, 0.18, 1) both;
  }

  .story-slide.is-turning-out-next::after {
    background: linear-gradient(90deg, transparent 45%, rgba(10, 7, 5, 0.58) 100%);
    animation: story-page-shadow 680ms ease both;
  }

  /* Efecto de hoja: capítulo anterior */
  .story-slide.is-turning-out-prev {
    z-index: 5;
    visibility: visible;
    transform-origin: right center;
    pointer-events: none;
    animation: story-page-out-prev 680ms cubic-bezier(0.42, 0, 0.18, 1) both;
  }

  .story-slide.is-turning-in-prev {
    z-index: 4;
    visibility: visible;
    transform-origin: left center;
    pointer-events: none;
    animation: story-page-in-prev 680ms cubic-bezier(0.42, 0, 0.18, 1) both;
  }

  .story-slide.is-turning-out-prev::after {
    background: linear-gradient(270deg, transparent 45%, rgba(10, 7, 5, 0.58) 100%);
    animation: story-page-shadow 680ms ease both;
  }

  @keyframes story-page-out-next {
    0% {
      opacity: 1;
      transform: rotateY(0deg) translateZ(0);
      filter: brightness(1);
    }
    48% {
      opacity: 1;
      transform: rotateY(-48deg) translateZ(16px);
      filter: brightness(0.86);
    }
    100% {
      opacity: 0;
      transform: rotateY(-92deg) translateZ(0);
      filter: brightness(0.72);
    }
  }

  @keyframes story-page-in-next {
    0% {
      opacity: 0.2;
      transform: rotateY(72deg) translateZ(0);
      filter: brightness(0.72);
    }
    52% {
      opacity: 0.8;
      transform: rotateY(22deg) translateZ(12px);
      filter: brightness(0.9);
    }
    100% {
      opacity: 1;
      transform: rotateY(0deg) translateZ(0);
      filter: brightness(1);
    }
  }

  @keyframes story-page-out-prev {
    0% {
      opacity: 1;
      transform: rotateY(0deg) translateZ(0);
      filter: brightness(1);
    }
    48% {
      opacity: 1;
      transform: rotateY(48deg) translateZ(16px);
      filter: brightness(0.86);
    }
    100% {
      opacity: 0;
      transform: rotateY(92deg) translateZ(0);
      filter: brightness(0.72);
    }
  }

  @keyframes story-page-in-prev {
    0% {
      opacity: 0.2;
      transform: rotateY(-72deg) translateZ(0);
      filter: brightness(0.72);
    }
    52% {
      opacity: 0.8;
      transform: rotateY(-22deg) translateZ(12px);
      filter: brightness(0.9);
    }
    100% {
      opacity: 1;
      transform: rotateY(0deg) translateZ(0);
      filter: brightness(1);
    }
  }

  @keyframes story-page-shadow {
    0%, 100% { opacity: 0; }
    45%, 65% { opacity: 1; }
  }

  .story-current-meta {
    width: min(760px, 100%);
    max-width: 100%;
    min-width: 0;
    margin: 0.95rem auto 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.72rem 0.9rem;
    border: 1px solid rgba(201, 173, 115, 0.2);
    border-bottom-color: rgba(201, 173, 115, 0.42);
    background: rgba(24, 29, 23, 0.72);
    color: #fff7e9;
  }

  .story-current-meta span {
    flex: 0 0 auto;
    color: #d2b478;
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .story-current-meta strong {
    min-width: 0;
    color: rgba(255, 247, 233, 0.9);
    font-family: var(--serif);
    font-size: 0.88rem;
    font-weight: 400;
    line-height: 1.25;
    text-align: right;
    text-wrap: balance;
  }

  .story-page-link,
  .story-page-link picture,
  .story-page-link img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .story-page-link {
    position: relative;
    overflow: hidden;
  }

  .story-page-link img {
    object-fit: contain;
    background: #2a1c18;
    user-select: none;
    -webkit-user-drag: none;
  }

  .story-controls {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.8rem;
    margin-top: 0.35rem;
  }

  .story-nav,
  .story-open {
    min-width: 0;
    max-width: 100%;
    min-height: 46px;
    border: 1px solid rgba(201, 173, 115, 0.34);
    border-radius: 999px;
    background: transparent;
    color: #efe7d7;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.07em;
    text-decoration: none;
    transition: background 220ms ease, transform 220ms ease, opacity 220ms ease;
