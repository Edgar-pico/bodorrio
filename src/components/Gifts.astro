---
import type { LinkConfig } from '../lib/wedding-config';

interface Props {
  amazon: LinkConfig;
  // Se conserva para no obligar a modificar index.astro.
  // Liverpool ya no se muestra ni se utiliza.
  liverpool?: LinkConfig;
}

const { amazon } = Astro.props;
---

<section id="regalos" class="gifts-section reveal-section" aria-labelledby="gifts-title">
  <div class="gifts-shell">
    <div class="gifts-copy">
      <span class="gift-star" aria-hidden="true">✦</span>
      <p class="gift-eyebrow">Mesa de regalos</p>

      <div class="gift-ornament" aria-hidden="true">
        <i></i><span>♡</span><i></i>
      </div>

      <h2 id="gifts-title">Un detalle para nuestro nuevo comienzo</h2>

      <p class="gift-intro">
        Tenemos una lista de regalos en Amazon; si prefieres hacernos un regalo desde otro lugar,
        también será muy bienvenido.
      </p>

      <div class="gifts-action" aria-label="Enlace a nuestra mesa de regalos">
        {amazon.url ? (
          <a class="gift-button" href={amazon.url} target="_blank" rel="noopener noreferrer">
            <span class="gift-button__store">Amazon</span>
            <span class="gift-button__action">Ver lista de regalos</span>
            <span aria-hidden="true">↗</span>
          </a>
        ) : (
          <span class="gift-button gift-button--disabled" aria-disabled="true">
            Amazon · disponible próximamente
          </span>
        )}
      </div>

      <p class="gift-note">Gracias por ser parte de nuestro comienzo.</p>
    </div>

    <!--
      Usamos la imagen únicamente como elemento decorativo.
      Se recorta hacia el lado derecho para mostrar regalos, flores y luces,
      evitando el texto que viene impreso dentro de la imagen original
      (incluida la antigua referencia a Liverpool).
    -->
    <div class="gifts-visual" aria-hidden="true">
      <picture>
        <source srcset="/mesa-regalos.webp" type="image/webp" />
        <img
          src="/mesa-regalos.jpg"
          alt=""
          width="1536"
          height="1024"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <div class="gifts-visual-shade"></div>
    </div>
  </div>
</section>

<style>
  .gifts-section {
    position: relative;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(5rem, 8vw, 8rem) clamp(1rem, 4vw, 4rem);
    background:
      radial-gradient(circle at 18% 12%, rgba(203, 174, 118, 0.11), transparent 26rem),
      linear-gradient(145deg, #fbf7ef, #f4eadc);
    color: #5d4a34;
  }

  .gifts-section::before {
    content: '';
    position: absolute;
    inset: clamp(0.7rem, 1.6vw, 1.4rem);
    border: 1px solid rgba(176, 137, 68, 0.18);
    pointer-events: none;
  }

  .gifts-shell {
    position: relative;
    z-index: 2;
    width: min(1380px, 100%);
    min-height: clamp(620px, 72svh, 820px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(420px, 0.78fr);
    overflow: hidden;
    border: 1px solid rgba(176, 137, 68, 0.24);
    background: rgba(255, 252, 246, 0.82);
    box-shadow: 0 28px 80px rgba(91, 70, 42, 0.1);
  }

  .gifts-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(3rem, 6vw, 6rem);
    text-align: center;
  }

  .gift-star {
    display: block;
    margin-bottom: 0.8rem;
    color: #b88e42;
    font-size: 1rem;
  }

  .gift-eyebrow {
    margin: 0;
    color: #9b7839;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .gift-ornament {
    width: min(190px, 60%);
    margin: 1.1rem auto 1.55rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    color: #c29b55;
  }

  .gift-ornament i {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, currentColor);
  }

  .gift-ornament i:last-child {
    background: linear-gradient(90deg, currentColor, transparent);
  }

  .gift-ornament span {
    font-size: 0.8rem;
  }

  .gifts-copy h2 {
    max-width: 610px;
    margin: 0;
    color: #674c32;
    font-family: var(--serif);
    font-size: clamp(2.6rem, 5.2vw, 4.7rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .gift-intro {
    max-width: 570px;
    margin: 1.45rem auto 0;
    color: #756454;
    font-family: var(--serif);
    font-size: clamp(1.02rem, 1.7vw, 1.2rem);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .gifts-action {
    width: min(430px, 100%);
    margin-top: 2rem;
  }

  .gift-button {
    min-height: 76px;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 0.8rem;
    width: 100%;
    padding: 0.95rem 1.1rem;
    border: 1px solid #785c36;
    border-radius: 2px;
    background: #735936;
    color: #fffaf0;
    text-align: left;
    text-decoration: none;
    transition: transform 220ms ease, box-shadow 220ms ease, background 220ms ease;
  }

  .gift-button > span[aria-hidden='true'] {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-size: 1rem;
  }

  .gift-button__store {
    grid-column: 1;
    grid-row: 1;
    font-family: var(--serif);
    font-size: 1.25rem;
  }

  .gift-button__action {
    grid-column: 1;
    grid-row: 2;
    margin-top: 0.12rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .gift-button:hover {
    transform: translateY(-2px);
    background: #624a2d;
    box-shadow: 0 12px 28px rgba(89, 65, 34, 0.16);
  }

  .gift-button--disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .gift-note {
    margin: 1.15rem 0 0;
    color: #84735f;
    font-family: var(--serif);
    font-size: 0.92rem;
    font-style: italic;
    text-align: center;
  }

  .gifts-visual {
    position: relative;
    min-width: 0;
    min-height: 100%;
    overflow: hidden;
    background: #f5eadb;
  }

  .gifts-visual,
  .gifts-visual picture,
  .gifts-visual img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .gifts-visual img {
    object-fit: cover;
    /*
      El recorte intencional hacia la derecha elimina del área visible
      el texto impreso de la imagen y conserva la decoración de regalos.
    */
    object-position: 88% center;
    transform: scale(1.03);
    user-select: none;
    -webkit-user-drag: none;
  }

  .gifts-visual-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(251, 247, 239, 0.28), transparent 30%),
      linear-gradient(180deg, rgba(255,255,255,0.02), rgba(232,210,178,0.08));
  }

  @media (max-width: 960px) {
    .gifts-shell {
      grid-template-columns: minmax(0, 1fr) minmax(330px, 0.72fr);
    }

    .gifts-copy {
      padding: clamp(2.5rem, 5vw, 4rem);
    }

    .gifts-copy h2 {
      font-size: clamp(2.4rem, 5.8vw, 4rem);
    }

    .gifts-visual img {
      object-position: 90% center;
    }
  }

  @media (max-width: 720px) {
    .gifts-section {
      padding: 0;
      background: #f8f1e5;
    }

    .gifts-section::before {
      display: none;
    }

    .gifts-shell {
      width: 100%;
      min-height: 0;
      display: flex;
      flex-direction: column;
      border: 0;
      box-shadow: none;
      background: transparent;
    }

    .gifts-visual {
      order: 1;
      position: relative;
      width: 100%;
      height: clamp(330px, 96vw, 470px);
      min-height: 0;
      border-bottom: 1px solid rgba(183, 155, 100, 0.22);
    }

    .gifts-visual::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      z-index: 2;
      height: 30%;
      pointer-events: none;
      background: linear-gradient(180deg, transparent, rgba(248, 241, 229, 0.96));
    }

    .gifts-visual img {
      object-position: 84% center;
      transform: scale(1.04);
    }

    .gifts-copy {
      order: 2;
      position: relative;
      z-index: 3;
      width: min(100% - 2rem, 560px);
      margin: clamp(-2rem, -5vw, -1.15rem) auto 0;
      padding: clamp(2.25rem, 8vw, 3.2rem) clamp(1.25rem, 6vw, 2rem) 3.4rem;
      border: 1px solid rgba(176, 137, 68, 0.25);
      background: rgba(255, 252, 246, 0.97);
      box-shadow: 0 24px 60px rgba(91, 70, 42, 0.08);
    }

    .gifts-copy h2 {
      max-width: 430px;
      font-size: clamp(2.15rem, 10vw, 3.25rem);
    }

    .gift-intro {
      max-width: 430px;
      margin-top: 1.25rem;
      font-size: clamp(1rem, 4.2vw, 1.12rem);
      line-height: 1.65;
    }

    .gifts-action {
      max-width: 430px;
      margin-top: 1.7rem;
    }

    .gift-button {
      min-height: 74px;
    }
  }

  @media (max-width: 430px) {
    .gifts-visual {
      height: clamp(320px, 103vw, 430px);
    }

    .gifts-visual img {
      object-position: 86% center;
    }

    .gifts-copy {
      width: calc(100% - 1.2rem);
      padding-inline: 1.15rem;
      padding-bottom: 3rem;
    }

    .gifts-copy h2 {
      font-size: clamp(2rem, 10.5vw, 2.8rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gift-button {
      transition: none;
    }
  }
</style>
