---
import type { LinkConfig } from '../lib/wedding-config';

interface Props {
  amazon: LinkConfig;
  liverpool: LinkConfig;
}

const { amazon, liverpool } = Astro.props;
---

<section id="regalos" class="gifts-section reveal-section" aria-labelledby="gifts-title">
  <picture class="gifts-background" aria-hidden="true">
    <source srcset="/mesa-regalos.webp" type="image/webp" />
    <img
      src="/mesa-regalos.jpg"
      alt=""
      width="1536"
      height="1024"
      loading="lazy"
      decoding="async"
    />
  </picture>

  <div class="gifts-overlay" aria-hidden="true"></div>

  <div class="gifts-shell">
    <div class="gifts-accessible-copy">
      <p class="eyebrow">Mesa de regalos</p>
      <h2 id="gifts-title">Un detalle para nuestro nuevo comienzo</h2>
      <p>
        Tenemos opciones en Amazon y Liverpool; si prefieres hacernos un regalo desde otro lugar,
        también será muy bienvenido.
      </p>
    </div>

    <div class="gift-panel" aria-label="Enlaces a nuestras mesas de regalos">
      <span class="gift-panel__eyebrow">Elige una opción</span>

      <div class="gift-actions">
        {amazon.url ? (
          <a class="gift-button" href={amazon.url} target="_blank" rel="noopener noreferrer">
            <span class="gift-button__store">Amazon</span>
            <span class="gift-button__action">Ver lista de regalos</span>
            <span aria-hidden="true">↗</span>
          </a>
        ) : (
          <span class="gift-button gift-button--disabled" aria-disabled="true">Amazon · disponible próximamente</span>
        )}

        {liverpool.url ? (
          <a class="gift-button gift-button--outline" href={liverpool.url} target="_blank" rel="noopener noreferrer">
            <span class="gift-button__store">Liverpool</span>
            <span class="gift-button__action">Ver mesa de regalos</span>
            <span aria-hidden="true">↗</span>
          </a>
        ) : (
          <span class="gift-button gift-button--outline gift-button--disabled" aria-disabled="true">Liverpool · disponible próximamente</span>
        )}
      </div>

      <p class="gift-note">Gracias por ser parte de nuestro comienzo.</p>
    </div>
  </div>
</section>

<style>
  .gifts-section {
    position: relative;
    min-height: clamp(760px, 100svh, 980px);
    display: grid;
    overflow: hidden;
    isolation: isolate;
    background: #f6efe4;
    color: #5d4a34;
  }

  .gifts-background,
  .gifts-overlay {
    position: absolute;
    inset: 0;
  }

  .gifts-background {
    z-index: -3;
  }

  .gifts-background,
  .gifts-background img {
    width: 100%;
    height: 100%;
  }

  .gifts-background img {
    object-fit: cover;
    object-position: 50% 50%;
  }

  .gifts-overlay {
    z-index: -2;
    background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(230,211,180,0.05));
    pointer-events: none;
  }

  .gifts-shell {
    width: min(1500px, calc(100% - 2rem));
    min-height: inherit;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(390px, 0.75fr);
    align-items: end;
    padding: clamp(4rem, 8vw, 7rem) clamp(1rem, 4vw, 4rem) clamp(4rem, 7vw, 6rem);
  }

  .gifts-accessible-copy {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .gift-panel {
    grid-column: 1;
    width: min(620px, 100%);
    justify-self: center;
    padding: clamp(1.35rem, 3vw, 2rem);
    border: 1px solid rgba(176, 137, 68, 0.34);
    border-radius: 3px;
    background: rgba(255, 252, 246, 0.78);
    box-shadow: 0 24px 70px rgba(97, 72, 37, 0.14);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .gift-panel__eyebrow {
    display: block;
    margin-bottom: 1rem;
    color: #9b7839;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-align: center;
  }

  .gift-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .gift-button {
    min-height: 76px;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 0.8rem;
    padding: 0.95rem 1.05rem;
    border: 1px solid #785c36;
    border-radius: 2px;
    background: #735936;
    color: #fffaf0;
    text-align: left;
    text-decoration: none;
    transition: transform 220ms ease, box-shadow 220ms ease, background 220ms ease;
  }

  .gift-button > span[aria-hidden='true'] {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-size: 1rem;
  }

  .gift-button__store {
    grid-column: 1;
    grid-row: 1;
    font-family: var(--serif);
    font-size: 1.2rem;
  }

  .gift-button__action {
    grid-column: 1;
    grid-row: 2;
    margin-top: 0.15rem;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.78;
  }

  .gift-button--outline {
    background: rgba(255,255,255,0.4);
    color: #6b5231;
  }

  .gift-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(89, 65, 34, 0.16);
    background: #624a2d;
  }

  .gift-button--outline:hover {
    background: rgba(255,255,255,0.72);
  }

  .gift-button--disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .gift-note {
    margin: 1rem 0 0;
    color: #84735f;
    font-family: var(--serif);
    font-size: 0.92rem;
    text-align: center;
  }

  @media (max-width: 900px) {
    .gifts-section {
      min-height: 920px;
    }

    .gifts-background img {
      object-position: 62% 50%;
    }

    .gifts-shell {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding: 4rem 0.5rem 3rem;
    }

    .gift-panel {
      width: min(620px, 100%);
    }
  }

  @media (max-width: 600px) {
    .gifts-section {
      min-height: 850px;
    }

    .gifts-background img {
      object-position: 58% 50%;
    }

    .gifts-overlay {
      background: linear-gradient(180deg, rgba(255,255,255,0.05) 0%, rgba(248,241,229,0.18) 48%, rgba(248,241,229,0.5) 100%);
    }

    .gifts-accessible-copy {
      position: absolute;
      top: 1.2rem;
      left: 50%;
      width: min(calc(100% - 1.5rem), 500px);
      height: auto;
      margin: 0;
      padding: 1rem 1.1rem;
      overflow: visible;
      clip: auto;
      white-space: normal;
      border: 1px solid rgba(176, 137, 68, 0.22);
      background: rgba(255, 252, 246, 0.76);
      transform: translateX(-50%);
      text-align: center;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }

    .gifts-accessible-copy .eyebrow {
      margin: 0 0 0.45rem;
      color: #9b7839;
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }

    .gifts-accessible-copy h2 {
      margin: 0;
      font-family: var(--serif);
      font-size: clamp(1.65rem, 8vw, 2.25rem);
      font-weight: 400;
      line-height: 1.08;
    }

    .gifts-accessible-copy p:last-child {
      margin: 0.7rem 0 0;
      color: #786957;
      font-family: var(--serif);
      font-size: 0.88rem;
      line-height: 1.5;
    }

    .gifts-shell {
      padding-bottom: 1rem;
    }

    .gift-panel {
      padding: 1rem;
      background: rgba(255, 252, 246, 0.88);
    }

    .gift-actions {
      grid-template-columns: 1fr;
    }

    .gift-button {
      min-height: 68px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gift-button {
      transition: none;
    }
  }
</style>
